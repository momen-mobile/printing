{
  "name": "printing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/generate-ico.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/generate-ico.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "cf:build": "npx @opennextjs/cloudflare build",
    "cf:preview": "npx @opennextjs/cloudflare preview",
    "cf:deploy": "npx @opennextjs/cloudflare deploy; code=$?; if [ \"$code\" -ne 0 ]; then node scripts/report-worker-startup-profile.mjs; fi; exit $code",
    "cf:typegen": "npx wrangler types"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "googleapis": "^189.0.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "mammoth": "^1.13.0",
    "next": "16.4.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "20.19.37",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prisma": "^6.19.3",
    "typescript": "^5",
    "vitest": "3.2.7",
  }
}
